# Copy to backend/.env for local runs. On a host, set these in the provider's environment settings.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-of-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Karachi

# Database: leave empty for SQLite (local). Production example:
# DATABASE_URL=postgres://user:password@host:5432/hcm
DATABASE_URL=

# Optional first-run bootstrap (otherwise the browser shows the setup screen)
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_NAME=AR&MS Management Company

# AI assistant - the key stays on the server.
# Option A: Claude (Anthropic)
#   AI_PROVIDER=anthropic   AI_MODEL=claude-opus-5-5   AI_EFFORT=low
# Option B: any OpenAI-compatible API with tool calling (free tiers work), e.g.
#   Groq:   AI_PROVIDER=openai AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=openai/gpt-oss-120b
#   Gemini: AI_PROVIDER=openai AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_MODEL=gemini-2.5-flash
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_BASE_URL=
AI_EFFORT=low
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20
